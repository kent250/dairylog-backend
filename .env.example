
# ============================================================
# ⚙️ General Settings
# ============================================================

# Node environment: development | staging | production
NODE_ENV=development
SERVER_PORT=3000
API_BASE_URL=http://localhost:3000
DEBUG_MODE=false

# ============================================================
# 🗄️ Database Configuration
# ============================================================
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB_NAME"


# ============================================================
# 🔐 CORS Configuration
# ============================================================
CORS_ORIGINS_PRODUCTION=https://your-production-domain.com
CORS_ORIGINS_STAGING=https://staging.your-domain.com
CORS_ORIGINS_DEVELOPMENT=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS_LOCAL=http://localhost:3000,http://127.0.0.1:3000


# ============================================================
# Development Tools
# ============================================================
# Use polling for file watching in specific environments (e.g., Docker on Windows)
CHOKIDAR_USEPOLLING=true