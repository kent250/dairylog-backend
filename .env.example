
# ============================================================
# ⚙️ General Settings
# ============================================================

# Node environment: development | staging | production
NODE_ENV=development
SERVER_PORT=3000
API_BASE_URL=http://localhost:3000
DEBUG_MODE=false

# ============================================================
# 🗄️ Database Configuration
# ============================================================
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB_NAME"


# ============================================================
# 🔐 CORS Configuration
# ============================================================
CORS_ORIGINS_PRODUCTION=https://your-production-domain.com
CORS_ORIGINS_STAGING=https://staging.your-domain.com
CORS_ORIGINS_DEVELOPMENT=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS_LOCAL=http://localhost:3000,http://127.0.0.1:3000


# ============================================================
# Development Tools
# ============================================================
# Use polling for file watching in specific environments (e.g., Docker on Windows)
CHOKIDAR_USEPOLLING=true


# ============================================================
# 🔐 Authentication & Security
# ============================================================

# JWT Secret - CRITICAL: Change this in production!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your_access_token_secret_key"
JWT_REFRESH_SECRET="your_refresh_token_secret_key"

# 🛡️ Bcrypt Hashing Configuration
# The number of salt rounds for password and token hashing (10 is standard).
# Higher values are more secure but slower. Must be a number.
BCRYPT_SALT_ROUNDS=10

# Set to false to ensure 'npm install' installs devDependencies, crucial for development environments. should be used in build time only 
NPM_CONFIG_PRODUCTION=false



# ============================================================
# 🔐 Easy Send SMS Configurations
# ============================================================

# The base URL for the EasySendSMS REST API endpoint used for sending messages.
EASY_SEND_SMS_API_URL=easysender-api-base-url

# The Sender ID (name or number) displayed to the SMS recipient (e.g., 'DairyLog').
# Check EasySendSMS for length restrictions (alphanumeric vs. numeric).
EASY_SEND_SMS_SENDER_ID=YourSenderID

# Your secret API key provided by EasySendSMS for authenticating API requests.
EASY_SEND_SMS_API_KEY=YOUR_API_KEY_HERE