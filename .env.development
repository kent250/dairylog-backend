# ============================================================
# ⚙️ General Settings
# ============================================================

# Node environment: development | staging | production
NODE_ENV=development
SERVER_PORT=3000
API_BASE_URL=http://localhost:3000
DEBUG_MODE=false

# ============================================================
# 🗄️ Database Configuration
# ============================================================
DATABASE_URL="postgres://admin:admin@localhost:5432/dairylog-db?sslmode=disable"


# ============================================================
# 🔐 CORS Configuration
# ============================================================
CORS_ORIGINS_PRODUCTION=https://your-production-domain.com
CORS_ORIGINS_STAGING=https://staging.your-domain.com
CORS_ORIGINS_DEVELOPMENT=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS_LOCAL=http://localhost:3000,http://127.0.0.1:3000


# ============================================================
# Development Tools
# ============================================================
# Use polling for file watching in specific environments (e.g., Docker on Windows)
CHOKIDAR_USEPOLLING=true



# JWT Secret Key
# ⚠️  CRITICAL: Must be changed in production!
# Generate secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters, recommended 64+ characters
JWT_ACCESS_SECRET=8f3a2b1c9d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f
JWT_REFRESH_SECRET=8f3a2b1c9d7e6f5a4b3c2d140f9a8bec6d5e4f3a2f1c0d9e8f7a6b5c4f3e2f1a0b9c8d7e6e5a4b3c2d1edf9a8b7c6d5e4f

BCRYPT_SALT_ROUNDS=10